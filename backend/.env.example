# Copy to backend/.env and fill in. Never commit backend/.env.

# Hackathon gateway (OpenAI-compatible). Used automatically when TEAM_API_KEY is set.
# Comments go on their own line. UNOBIO_LLM_BASE_URL is the gateway base URL, ending in /v1.
# UNOBIO_LLM_MODEL: one id from the gateway's /v1/models (check_llm lists them), e.g. gpt-6-luna or gpt-5-mini.
TEAM_API_KEY=
UNOBIO_LLM_BASE_URL=
UNOBIO_LLM_MODEL=gpt-6-luna
# Output token limit. The gateway refuses 16000 ("Output token limit is outside the supported range"); 4096 works and
# is enough (answers are 1-2k tokens). A refused value is stepped down automatically, at the cost of a refused request.
UNOBIO_LLM_MAX_TOKENS=4096
# Batches are packed to this many estimated input tokens (the gateway refuses roughly 4k and up).
# UNOBIO_LLM_INPUT_BUDGET=3500
# LLM requests in flight at once; 1 = one after the other.
# UNOBIO_LLM_WORKERS=4

# Alternatives: OPENAI_API_KEY=...  or  XAI_API_KEY=...  (UNOBIO_LLM_PROVIDER=openai|xai to force one)
# UNOBIO_LLM_REASONING=low      # reasoning effort; empty = not sent (dropped automatically if the model rejects it)

# Translation-chain sources (backend/app/sources/). openFDA, UniProt and PubMed need no key.
# OPENFDA_API_KEY=              # optional, raises the openFDA daily limit
# NCBI_API_KEY=                 # optional, PubMed 10 instead of 3 requests a second
# NCBI_EMAIL=                   # optional, NCBI asks tools to identify themselves
# AACT_DSN=postgresql://user:password@localhost:5432/aact   # your local AACT copy; without it AACT is skipped
# UNOBIO_OFFLINE=1              # cache only, never the network (tests set this)
